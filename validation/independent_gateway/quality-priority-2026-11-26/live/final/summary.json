      "answer": "def dedupe_net(events):\n    seen = {}\n    total = 0\n    for record in events:\n        event = record[\"event\"]\n        amount = record[\"amount\"]\n        if event in seen:\n            if seen[event] != amount:\n                raise ValueError(\n                    f\"event {event} amount conflict: {seen[event]} vs {amount}\"\n                )\n            continue\n        seen[event] = amount\n        total += amount\n    return total",
