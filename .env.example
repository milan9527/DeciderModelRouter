# Export these in your shell; this file is not loaded automatically.
# Independent API: uvicorn app.gateway_main:app --host 127.0.0.1 --port 8000
# Legacy application (historical demos): app.main:app
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_TIMEOUT=180
# To use the shared vLLM service, set GPU_PROVIDER=vllm, its private
# STRANDS_DECIDER_URL, and a server-side DECIDER_API_KEY. Never commit the key.
GPU_PROVIDER=ec2
DECIDER_API_KEY=
VLLM_INSTANCE_ID=
# Optional official image inference service; empty enables recorded examples only.
DECIDER_VISION_URL=
# Only for local HTTP development; AWS requires true.
AUTH_COOKIE_SECURE=false
AUTH_DB_PATH=.data/auth.sqlite3
# Persistent independent gateway history/evaluations, SQLite for local development.
GATEWAY_DB_PATH=.data/gateway.sqlite3
# Local private uploads/generated media; production uses the dedicated private S3 bucket.
GATEWAY_MEDIA_DIR=.data/media
# GATEWAY_MEDIA_BUCKET=decider-model-router-media-ACCOUNT-us-east-1
# Production uses separate DynamoDB tables, injected by release_independent.py:
# AUTH_TABLE=decider-model-router-auth
# GATEWAY_DATA_TABLE=decider-model-router-data
# AUTH_ORIGIN=https://YOUR_DEDICATED_DISTRIBUTION.cloudfront.net
# Optional real GPT-6.1 Sol comparison through the current AWS credentials.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
# Optional Jev comparison; read the key only on the backend, never in the browser.
JEV_API_KEY_FILE=
# AWS uses an IAM-only Lambda bridge with a Secrets Manager credential.
JEV_FUNCTION_NAME=
# AWS deployment configures AUTH_TABLE, AWS_REGION and AUTH_ORIGIN automatically.
# Optional model launcher configuration:
DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19
DECIDER_DEVICE=cpu
# Independent gateway frontend: python -m scripts.serve_gateway --api http://127.0.0.1:8000
# Run the API with SERVE_FRONTEND=false. Same-origin proxy preserves cookie authentication.
SERVE_FRONTEND=false
# Standalone GPU services are managed separately; the gateway never starts/stops them.
GATEWAY_DECISION_PROVIDER=liquid
# Optional override; otherwise STRANDS_DECIDER_URL is used.
GATEWAY_DECIDER_URL=http://127.0.0.1:8099
# Optional exact response identity; vLLM deployments default to their service alias.
GATEWAY_DECIDER_MODEL=
# Private resident Liquid/H2O gateway. When set, H2O is the default unless overridden above.
OPEN_MODELS_URL=
OPEN_MODELS_API_KEY=
